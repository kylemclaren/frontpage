# Required for scoring stories (https://typesafe.ai). Without it, the feed shows unscored.
TYPESAFE_API_KEY=

# Optional
# Scoring model (defaults to jev-latest)
# JEV_MODEL=jev-latest

# Port for the API server (dev runs it on 4792 behind Vite on 4791)
# PORT=4791

# Postgres connection string for the shared score cache (on Fly, `fly mpg attach` sets it).
# When unset, a local SQLite file is used instead.
# DATABASE_URL=
# FRONTPAGE_DB=data/frontpage.sqlite

# Public origin used in social preview tags (read at build time)
# SITE_URL=http://localhost:4791
